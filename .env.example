# Copy to .env and fill in. Never commit .env.

# --- required ---
MONGO_URI=
# Public HTTPS address of this server. QR codes and email links are built from it.
BASE_URL=https://your-domain.example
# The register phone uses STAFF_KEY. ADMIN_KEY (the owner) can also undo old changes.
STAFF_KEY=
ADMIN_KEY=

# --- email (optional until you choose a provider; without these, emails are only
#     printed to the server console, and in production sending is refused) ---
RESEND_API_KEY=
MAIL_FROM="Saucies <cards@your-domain.example>"

# --- optional ---
SHOP_NAME=Saucies
PORT=3000
# Set to 1 when running behind a host's proxy (Render, Fly, Railway, ...), so rate
# limits see real visitor addresses.
TRUST_PROXY=
# Seconds in which a second punch on the same card needs staff to confirm.
PUNCH_COOLDOWN_SECONDS=300
# Largest number of pizzas staff can add in one go.
MAX_PUNCH_QTY=10
# Minutes staff can undo their last change (the owner has no limit).
UNDO_WINDOW_MINUTES=60
# Set to false to remove "approve without the emailed code" for verified cards.
ALLOW_FREE_OVERRIDE=true

# --- only used by the dormant legacy system (npm run legacy) ---
LEGACY_PORT=3001
NTFY_TOPIC=
DAILY_REDEMPTION_ALERT_THRESHOLD=50
